# Copy to backend/.env for local development. In production set these in your
# host's environment settings. Never commit real values.

ENVIRONMENT=development            # development | production
# Neon gives you a postgresql://... URL; it is converted to the psycopg driver automatically.
DATABASE_URL=sqlite:///./teamhub.db

# Generate all three with: python -m app.cli generate-keys
SECRET_KEY=
FIELD_ENCRYPTION_KEY=
JOBS_TOKEN=

# Base URL for links in emails (offer, set-password and reset-password links).
# The backend serves these pages itself at /offer/<token>, /set-password,
# /reset-password and /forgot-password, so until the React frontend exists set
# this to the API's own URL, e.g. https://saxs-team-hub-api.onrender.com
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Interactive API docs at /docs (always on outside production). Set true in
# production to manage the Team Hub from a browser until the frontend is built.
ENABLE_API_DOCS=false

# Founder's inbox for viewed / accepted / declined / expired alerts
ADMIN_NOTIFY_EMAIL=

# Zoho Mail SMTP
#   smtppro.zoho.com  address on your own domain    smtp.zoho.com  free @zoho.com address
#   (other Zoho regions: use that region's host, e.g. smtppro.zoho.eu)
#   SMTP_PASS = an application-specific password (Zoho Accounts > Security > App Passwords)
# Test with: python -m app.cli check-email
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Leave empty to send from SMTP_USER (Zoho only allows that mailbox or a verified alias)
SMTP_FROM=
SMTP_FROM_NAME=SaxsProjects

COMPANY_NAME=SaxsProjects
TIMEZONE=Africa/Johannesburg
PAYOUT_DELAY_DAYS=7
DECLINED_RETENTION_DAYS=365
